{
  "name": "cardpin",
  "private": true,
  "version": "1.2.17",
  "packageManager": "pnpm@10.34.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "pnpm compile:data && turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format:data": "tsx scripts/format-datasets.ts",
    "validate:data": "tsx scripts/compile-datasets.ts --validate-only",
    "compile:data": "tsx scripts/compile-datasets.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "pnpm": "10.34.5",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}

